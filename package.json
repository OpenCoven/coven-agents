{
  "name": "coven-agents",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "account": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/account.ts",
    "beads:seed": "tsx scripts/beads-roadmap-seed.ts",
    "beads:sync": "tsx scripts/beads-project-sync.ts",
    "build": "pnpm validate:runtime && tsx lib/db/migrate.ts && next build",
    "check": "pnpm validate:platform-residue && pnpm familiar:assets:check && ultracite check && pnpm planning:check && pnpm db:check",
    "credentials:rewrap": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/credentials-rewrap.ts",
    "daytona:snapshot": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/daytona-snapshot.ts",
    "db:check": "drizzle-kit check --dialect postgresql --out ./lib/db/migrations && tsx scripts/db-drift.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx lib/db/migrate.ts",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:up": "drizzle-kit up",
    "db:verify": "tsx --conditions=react-server scripts/db-verify.ts",
    "demo:record": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/demo-record.ts",
    "dev": "next dev --turbo --hostname localhost --port 3036",
    "familiar:assets": "tsx scripts/familiar-assets.ts build",
    "familiar:assets:check": "tsx scripts/familiar-assets.ts check",
    "fix": "ultracite fix",
    "hygiene": "tsx scripts/hygiene.ts",
    "planning:check": "tsx scripts/planning-docs-policy.ts",
    "prepare": "husky",
    "readiness:check": "tsx scripts/readiness-receipt.ts",
    "roadmap:status": "tsx scripts/roadmap-status.ts",
    "secret:scan": "tsx scripts/secret-scan.ts --staged",
    "secret:scan:all": "tsx scripts/secret-scan.ts --tracked",
    "secret:scan:history": "tsx scripts/secret-scan.ts --history",
    "staging:certify": "tsx scripts/staging-certification.ts",
    "start": "pnpm validate:release && next start",
    "subscription": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/subscription.ts",
    "test": "export PLAYWRIGHT=True && pnpm exec playwright test",
    "test:e2e:hermetic": "tsx --conditions=react-server scripts/e2e-hermetic.ts",
    "test:unit": "tsx --test scripts/*.test.ts && tsx --conditions=react-server --test 'lib/**/*.test.ts' 'app/**/*.test.ts' && pnpm --filter @opencoven/agent-contracts test && pnpm --filter @opencoven/harness test",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "validate:platform-residue": "tsx scripts/platform-residue-scan.ts",
    "validate:platform-residue:index": "tsx scripts/platform-residue-scan.ts --index",
    "validate:release": "tsx scripts/validate-runtime-config.ts --release",
    "validate:runtime": "tsx scripts/validate-runtime-config.ts"
  },
  "lint-staged": {
    "*": "corepack pnpm run fix --"
  },
  "dependencies": {
    "@ai-sdk/otel": "^1.0.173",
    "@ai-sdk/provider": "^4.0.38",
    "@ai-sdk/react": "4.0.177",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@create-markdown/core": "2.0.3",
    "@create-markdown/preview": "2.0.3",
    "@daytona/sdk": "0.231.1",
    "@next/env": "16.4.6",
    "@opencoven/agent-contracts": "workspace:*",
    "@opencoven/harness": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.3",
    "@vercel/otel": "^2.3.0",
    "ai": "7.0.173",
    "botid": "^1.5.13",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "diff-match-patch": "^1.0.5",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fast-deep-equal": "^3.1.3",
    "framer-motion": "^12.43.0",
    "jose": "6.2.12",
    "katex": "^0.19.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "nanoid": "^6.0.1",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "orderedmap": "^2.1.1",
    "papaparse": "^5.7.1",
    "postgres": "^3.4.9",
    "prosemirror-example-setup": "^1.2.4",
    "prosemirror-inputrules": "^1.6.0",
    "prosemirror-markdown": "^1.13.9",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-data-grid": "7.0.0-beta.61",
    "react-dom": "19.3.1",
    "redis": "^6.3.1",
    "resumable-stream": "^2.2.13",
    "sanitize-html": "2.18.2",
    "server-only": "^0.0.1",
    "shiki": "^3.23.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "stripe": "^22.6.2",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "use-stick-to-bottom": "^1.1.6",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@github/copilot": "1.0.112",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "2.16.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.33",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@5.8.2",
    "ultracite": "^7.12.2"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "@ai-sdk/provider-utils": "^5.0.30",
      "@auth/core": ">=0.41.3",
      "@opentelemetry/core": ">=2.8.0",
      "ai": "^7.0.79",
      "brace-expansion": ">=5.0.9",
      "dompurify": ">=3.4.13",
      "esbuild": ">=0.25.0",
      "kysely": ">=0.28.17",
      "linkify-it": "^5.0.2",
      "lodash-es": "^4.18.0",
      "markdown-it": "^14.2.0",
      "mdast-util-to-hast": ">=13.2.1",
      "mermaid": ">=11.16.1",
      "nanoid": ">=3.3.18",
      "postcss": "^8.5.23",
      "prosemirror-transform": "1.12.5",
      "sharp": ">=0.35.0",
      "undici": ">=5.29.0",
      "uuid": ">=11.1.1"
    }
  }
}
