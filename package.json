{
  "name": "coven-agents",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "check": "ultracite check",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx lib/db/migrate.ts",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:up": "drizzle-kit up",
    "dev": "next dev --turbo",
    "dev:cloud": "pnpm --filter @opencoven/cloud-runner dev",
    "dev:local-runner": "pnpm --filter @opencoven/local-runner dev",
    "fix": "ultracite fix",
    "hygiene": "tsx scripts/hygiene.ts",
    "prepare": "husky",
    "start": "next start",
    "test": "export PLAYWRIGHT=True && pnpm exec playwright test",
    "test:unit": "tsx --test scripts/*.test.ts && tsx --test lib/agents/*.test.ts && pnpm --filter @opencoven/agent-contracts test && pnpm --filter @opencoven/harness test && pnpm --filter @opencoven/local-runner test && pnpm --filter @opencoven/cloud-runner test",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*": "corepack pnpm run fix --"
  },
  "dependencies": {
    "@ai-sdk/otel": "^1.0.73",
    "@ai-sdk/provider": "^4.0.7",
