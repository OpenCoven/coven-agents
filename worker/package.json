{
  "name": "@opencoven/cloud-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "harness:mint": "node --env-file-if-exists=.dev.vars harness/mint.mjs",
    "harness:run": "node --env-file-if-exists=.dev.vars harness/run.mjs",
    "harness:stub": "node --env-file-if-exists=.dev.vars harness/stub-credential.mjs",
    "harness:test": "node --test harness/*.test.mjs",
    "test": "pnpm harness:test && tsx --tsconfig tsconfig.test.json --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.7",
    "@opencoven/agent-contracts": "workspace:*",
    "@opencoven/harness": "workspace:*",
    "agents": "0.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "wrangler": "4.125.0"
  }
}
