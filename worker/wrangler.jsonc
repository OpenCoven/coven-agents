{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coven-agents-runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ratelimits": [
    {
      "name": "EDGE_REQUEST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "TENANT_MUTATION_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "TENANT_RUN_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://agents.opencoven.ai",
    "RUN_ADMISSION_CONSECUTIVE_MAX": "2",
    "RUN_ADMISSION_DEPLOYMENT_ACTIVE_MAX": "25",
    "RUN_ADMISSION_MODE": "queue",
    "RUN_ADMISSION_TENANT_ACTIVE_MAX": "2",
    "RUN_ADMISSION_TENANT_QUEUE_MAX": "10"
  },
  "containers": [
    {
      "class_name": "Sandbox",
      // Built from worker/Dockerfile so the harness CLI exists in the sandbox.
      // The stock image has no coding CLI, and Coven Agents runs the harness
      // rather than calling a model provider from the Worker.
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      },
      {
        "class_name": "AgentDirectory",
        "name": "AgentDirectory"
      },
      {
        "class_name": "YoloAgent",
        "name": "YoloAgent"
      },
      {
        "class_name": "RunAdmission",
        "name": "RunAdmission"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox", "AgentDirectory", "YoloAgent"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["RunAdmission"],
      "tag": "v2"
    }
  ]
}
