# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****
# Canonical Auth.js origin. External demo capture requires APP_ORIGIN to match
# AUTH_URL/NEXTAUTH_URL or the active Vercel deployment authority exactly.
AUTH_URL=

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# Credential envelope KEK ring. Production requires the current version and its
# matching key; local/CI builds may leave every CREDENTIAL_KEK* variable unset.
# New writes use the current version and each credential row names its wrapping
# version. Retain v1 through rewrap and the zero-row
# `pnpm credentials:rewrap verify --version v1` gate. During migration,
# CREDENTIAL_KEK may alias only explicit legacy v1; it is never a fallback.
CREDENTIAL_KEK_CURRENT_VERSION=v2
CREDENTIAL_KEK_V1=
CREDENTIAL_KEK_V2=
CREDENTIAL_KEK=
# Keep false while old application readers are serving traffic. Set true only
# after every reader has been upgraded and old instances have drained.
CREDENTIAL_AAD_WRITES_ENABLED=false
# Legacy rollback-only bridge for old Worker credential requests that lack a
# run scope. Keep false for the current same-origin Daytona path; enable only
# during an explicitly coordinated application and Worker rollback.
CREDENTIAL_LEGACY_LENDING_ENABLED=false

# Production admission requires REDIS_URL, ABUSE_KEY_SECRET, and a positive
# GLOBAL_DAILY_RUN_CAP together. Protected app request policies fail closed
# with 503 without Redis in production.
REDIS_URL=
# HMAC key for Redis subjects and run-reservation tenant hashes. Generate a
# unique random production value and keep it out of source control.
ABUSE_KEY_SECRET=
# Positive integer for deployment-wide run reservations. Missing or invalid
# configuration makes credential lending fail closed with 503.
GLOBAL_DAILY_RUN_CAP=
# Emergency kill switch for app request-policy enforcement only: exactly "off"
# bypasses those policies and logs loudly. It does not bypass run reservations,
# cap enforcement, or Worker rate limiters. Unset it after the incident.
ABUSE_CONTROL=

# Daytona runner control plane. Production requires the API key, snapshot,
# Redis URL, abuse key, reconcile secret, and operator token. Other values
# default to the listed production-safe settings when omitted.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
DAYTONA_SNAPSHOT=coven-agents-copilot-1
DAYTONA_AUTO_STOP_MINUTES=15
DAYTONA_AUTO_ARCHIVE_MINUTES=10080
# Required in production. Comma-separated domain names only (no URL schemes,
# paths, or ports); set the least-privilege domains required by your snapshot.
DAYTONA_DOMAIN_ALLOW_LIST=
CRON_SECRET=
RUN_ADMISSION_MODE=queue
RUN_ADMISSION_CONSECUTIVE_MAX=2
RUN_ADMISSION_DEPLOYMENT_ACTIVE_MAX=25
RUN_ADMISSION_TENANT_ACTIVE_MAX=2
RUN_ADMISSION_TENANT_QUEUE_MAX=10
OPERATOR_DIAGNOSTIC_TOKEN=

# App-to-Worker deployment gate and internal-service credential. Generate
# separate random values; copy each exact value to the matching Worker secret.
AGENT_CONTROL_TOKEN=
RUNNER_SERVICE_TOKEN=

# Runner identity verification key ring retained while the Worker calls the
# internal authority and credential routes. These public values must match the
# still-deployed Worker's signing-token configuration.
RUNNER_VERIFY_KEY_ID=
RUNNER_VERIFY_KEY=
# During rotation, keep the old public key until all 15-minute tokens expire.
RUNNER_VERIFY_PREVIOUS_KEY_ID=
RUNNER_VERIFY_PREVIOUS_KEY=
# Set when the app stopped signing with the previous key. Retirement must be
# no earlier than this timestamp plus the token lifetime and clock skew.
RUNNER_VERIFY_PREVIOUS_LAST_SIGNED_AT=
RUNNER_VERIFY_PREVIOUS_RETIRE_AT=

# Owner-only demo transcript recorder.
# Verified, subscribed User row used as the recorder authority. The recorder
# derives a short-lived application session from this row and AUTH_SECRET, then
# sends that cookie only to APP_ORIGIN.
DEMO_RECORDER_ACCOUNT_EMAIL=
DEMO_RECORDING_CREDENTIAL=****
# Optional; defaults to 15 minutes.
DEMO_RECORDING_TIMEOUT_MS=900000

# Production and explicit release validation require RELEASE_AUDIENCE to be
# exactly "closed-beta" or "public". Ordinary local and Vercel preview
# validate:runtime runs do not require a decision; validate:release always does.
RELEASE_AUDIENCE=
# Closed beta requires BETA_MODE exactly "on" plus a reviewed, nonempty,
# comma-separated BETA_ALLOWLIST containing valid email addresses. A separately
# approved public release requires BETA_MODE exactly "off". Leaving it blank is
# a local default only and never counts as release approval. The allowlist is
# case-insensitive; when beta mode is on, an empty or mistyped list denies
# everyone.
BETA_MODE=
BETA_ALLOWLIST=

# GitHub OAuth sign-in. REQUIRED: it is the only sign-in path, so without
# these nobody can enter the app at all.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Billing (Stripe) -----------------------------------------------------
# Without these, checkout and the webhook return 503 and the rest of the app
# is unaffected. The cap itself lives in lib/billing/limits.ts, not here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The $25/month recurring price object.
STRIPE_PRICE_ID=
# Absolute application origin used for Checkout URLs and authenticated demo
# capture requests.
APP_ORIGIN=

# Exact emails allowed into the Warden admin surface. Empty means nobody.
ADMIN_EMAILS=
