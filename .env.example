# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# Required when REDIS_URL or GLOBAL_DAILY_RUN_CAP is set. Generate a unique
# random production value (for example, `openssl rand -base64 32`) and keep it
# out of source control.
ABUSE_KEY_SECRET=
# Set to a positive integer to enable deployment-wide run reservations.
GLOBAL_DAILY_RUN_CAP=
# Existing Redis connection used for distributed abuse budgets.
REDIS_URL=
# Emergency kill switch: exactly "off" lifts all abuse enforcement.
# Loud in the logs; unset it once the incident is over.
ABUSE_CONTROL=

# Public runner endpoints used by the browser control plane.
NEXT_PUBLIC_CLOUD_RUNNER_URL=http://127.0.0.1:8787

# Owner-only demo transcript recorder.
DEMO_RUNNER_URL=http://127.0.0.1:8787
DEMO_RUNNER_TOKEN=****
# Ed25519 PKCS8 key matching the worker's RUNNER_VERIFY_KEY.
DEMO_RUNNER_SIGNING_KEY=****
DEMO_RUNNER_SUBJECT=demo-recorder
# Must match /^[A-Za-z0-9_]{1,64}$/ -- it becomes a sandbox key component,
# and a `-` here is refused when the run derives one.
DEMO_RUNNER_TENANT=demo_recorder
DEMO_RECORDING_CREDENTIAL=****
# Optional; defaults to 15 minutes.
DEMO_RECORDING_TIMEOUT_MS=900000

# Closed beta. The gate is off unless BETA_MODE is exactly "on"; once on it
# fails closed, so an empty or mistyped BETA_ALLOWLIST denies everyone rather
# than publishing the app. Comma-separated, case-insensitive.
BETA_MODE=
BETA_ALLOWLIST=

# GitHub OAuth sign-in. REQUIRED: it is the only sign-in path, so without
# these nobody can enter the app at all.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Billing (Stripe) -----------------------------------------------------
# Without these, checkout and the webhook return 503 and the rest of the app
# is unaffected. The cap itself lives in lib/billing/limits.ts, not here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The $25/month recurring price object.
STRIPE_PRICE_ID=
# Absolute origin used for Checkout success/cancel URLs.
APP_ORIGIN=

# Exact emails allowed into the Warden admin surface. Empty means nobody.
ADMIN_EMAILS=
