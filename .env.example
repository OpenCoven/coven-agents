# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****
# Canonical Auth.js origin. External demo capture requires APP_ORIGIN to match
# AUTH_URL/NEXTAUTH_URL or the active Vercel deployment authority exactly.
AUTH_URL=

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# Credential envelope KEK ring. Production requires the current version and its
# matching key; local/CI builds may leave every CREDENTIAL_KEK* variable unset.
# New writes use the current version and each credential row names its wrapping
# version. Retain v1 through rewrap and the zero-row
# `pnpm credentials:rewrap verify --version v1` gate. During migration,
# CREDENTIAL_KEK may alias only explicit legacy v1; it is never a fallback.
CREDENTIAL_KEK_CURRENT_VERSION=v2
CREDENTIAL_KEK_V1=
CREDENTIAL_KEK_V2=
CREDENTIAL_KEK=
# Keep false while old application readers are serving traffic. Set true only
# after every reader has been upgraded and old instances have drained.
CREDENTIAL_AAD_WRITES_ENABLED=false
# Production admission requires REDIS_URL, ABUSE_KEY_SECRET, and a positive
# GLOBAL_DAILY_RUN_CAP together. Protected app request policies fail closed
# with 503 without Redis in production.
REDIS_URL=
# HMAC key for Redis subjects and run-reservation tenant hashes. Generate a
# unique random production value and keep it out of source control.
ABUSE_KEY_SECRET=
# Positive integer of run minutes the whole deployment may hold per UTC day.
# Each admitted run reserves RUN_MINUTE_RESERVATION (15) minutes until it
# settles, so size this in minutes, not runs. Missing or invalid configuration
# makes credential lending fail closed with 503.
GLOBAL_DAILY_RUN_CAP=
# Emergency kill switch for app request-policy enforcement only: exactly "off"
# bypasses those policies and logs loudly. It does not bypass run reservations,
# or cap enforcement. Unset it after the incident.
ABUSE_CONTROL=

# Daytona runner control plane. Production requires the API key, snapshot,
# Redis URL, abuse key, reconcile secret, and operator token. Other values
# default to the listed production-safe settings when omitted.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
DAYTONA_SNAPSHOT=coven-agents-copilot-1
# The snapshot named above is built with these resources, and every sandbox
# created from it inherits them; a sandbox create never names resources of its
# own because Daytona refuses that. Values outside the caps fail validation
# (CPU 1–4 cores, memory 1–8 GiB, disk 3–10 GiB), which are Daytona per-sandbox
# maxima rather than preferences. Changing any of them requires building a new
# snapshot and pointing DAYTONA_SNAPSHOT at it, because snapshots are immutable.
DAYTONA_SANDBOX_CPU_CORES=2
DAYTONA_SANDBOX_MEMORY_GIB=4
DAYTONA_SANDBOX_DISK_GIB=10
# An idle sandbox stops after 5–60 minutes (default 15) and a continuously
# stopped sandbox archives after 60–43,200 minutes (default seven days).
DAYTONA_AUTO_STOP_MINUTES=15
DAYTONA_AUTO_ARCHIVE_MINUTES=10080
# TTL (0) and automatic deletion (-1) are fixed server policy, not
# environment switches: valid persistent agent work is never silently
# destroyed. DB-fenced recovery and decommission remain deletion authority.
# Sandboxes also have public previews disabled and do not use volumes, forks,
# or warm pools.
# Required in production. Comma-separated domain names only (no URL schemes,
# paths, or ports); set the least-privilege domains required by your snapshot.
# When GITHUB_TEAMS_ENABLED=on, include the exact APP_ORIGIN hostname so the
# typed GitHub gateway remains reachable from restricted sandboxes.
DAYTONA_DOMAIN_ALLOW_LIST=
CRON_SECRET=
# Required in production for operator-triggered recovery. Keep distinct from
# CRON_SECRET and OPERATOR_DIAGNOSTIC_TOKEN.
RUNNER_MANUAL_RECONCILE_SECRET=
RUN_ADMISSION_MODE=queue
RUN_ADMISSION_CONSECUTIVE_MAX=2
RUN_ADMISSION_DEPLOYMENT_ACTIVE_MAX=25
RUN_ADMISSION_TENANT_ACTIVE_MAX=2
RUN_ADMISSION_TENANT_QUEUE_MAX=10
OPERATOR_DIAGNOSTIC_TOKEN=

# Owner-only demo transcript recorder.
# Verified, subscribed User row used as the recorder authority. The recorder
# derives a short-lived application session from this row and AUTH_SECRET, then
# sends that cookie only to APP_ORIGIN.
DEMO_RECORDER_ACCOUNT_EMAIL=
DEMO_RECORDING_CREDENTIAL=****
# Optional; defaults to 15 minutes.
DEMO_RECORDING_TIMEOUT_MS=900000

# Production and explicit release validation require RELEASE_AUDIENCE to be
# exactly "closed-beta" or "public". Ordinary local and Vercel preview
# validate:runtime runs do not require a decision; validate:release always does.
RELEASE_AUDIENCE=
# Closed beta requires BETA_MODE exactly "on" plus a reviewed, nonempty,
# comma-separated BETA_ALLOWLIST containing valid email addresses. A separately
# approved public release requires BETA_MODE exactly "off". Leaving it blank is
# a local default only and never counts as release approval. The allowlist is
# case-insensitive; when beta mode is on, an empty or mistyped list denies
# everyone.
BETA_MODE=
BETA_ALLOWLIST=

# GitHub OAuth sign-in. REQUIRED: it is the only sign-in path, so without
# these nobody can enter the app at all.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Coordinated GitHub teams ---------------------------------------------
# Exactly "on" enables installation-scoped GitHub authority for coordinated
# teams. Unset or "off" keeps installation and connection routes unavailable;
# GitHub-capable team steps still fail closed until the typed gateway lands.
GITHUB_TEAMS_ENABLED=off
# Create a separate GitHub App; never reuse the OAuth sign-in app or Copilot
# runtime credentials. Configure both its Setup URL and user authorization
# Callback URL as:
#   <APP_ORIGIN><base-path-if-any>/api/github/callback
# Enable redirect-on-update for the Setup URL. The setup callback binds the
# exact installation to a second, single-use user authorization. The resulting
# user token is used only for GET /user/installations, then the grant is
# revoked before repository metadata can be persisted.
# Keep "Request user authorization (OAuth) during installation" disabled; this
# server starts that bounded web flow only after validating the setup phase.
# Grant only Metadata read plus Contents write and the Issue, Pull request, and
# Organization project permissions required by approved team capabilities.
# Contents write lets approved familiars publish one reviewed branch commit
# through repository.commit without receiving a token or shell access. Install
# the App only on selected repositories (maximum 16), never "All repositories".
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Public client identifier from this dedicated GitHub App.
GITHUB_APP_CLIENT_ID=
# Server-only client secret for the short-lived user authorization proof.
GITHUB_APP_CLIENT_SECRET=
# PKCS#8 (`BEGIN PRIVATE KEY`) or PKCS#1 RSA (`BEGIN RSA PRIVATE KEY`) PEM.
# Keep the full private key in server-only secret storage, never in Git.
GITHUB_APP_PRIVATE_KEY=
# Dedicated state HMAC authority, distinct from the App private key and client
# secret, AUTH_SECRET, AUTH_GITHUB_SECRET, credential KEKs, abuse credentials,
# and every runner/operator secret. Generate independently, for example:
#   openssl rand -base64 48
GITHUB_STATE_SIGNING_SECRET=

# --- Billing (Stripe) -----------------------------------------------------
# Exactly "on" opens new subscription Checkout. Unset or "off" keeps every
# subscription CTA hidden and makes POST /api/checkout refuse before Stripe.
# This does not disable webhooks for existing subscribers.
SUBSCRIPTION_CHECKOUT_ENABLED=off
# Kept for compatibility. Production should use a least-privilege Stripe
# restricted key with Customer read/write (including Customer read for webhook
# owner recovery), Subscription read, Checkout Session read/write/expire, and
# Invoice/invoice-line read for webhook reconciliation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The $25/month recurring price object.
# Automatic Stripe Tax is not enabled; verify Product tax code, Price tax
# behavior, and active registrations before adding automatic_tax later.
STRIPE_PRICE_ID=
# Optional prepaid top-up packs, sold as one-time payments on the account
# page: comma-separated price_<id>:<minutes>. The launch offer is one pack,
# 100 bonus minutes for $20, e.g. price_bonus100:100. The app credits the
# minutes named here for that Price; Stripe shows the amount. Blank offers
# no packs. Pack minutes never expire and are drawn only after the monthly
# bucket is empty.
MINUTE_PACK_PRICES=
# Required canonical application origin used for CSRF enforcement, Checkout
# URLs, and authenticated demo capture requests. Must match AUTH_URL,
# NEXTAUTH_URL, or the active Vercel deployment authority exactly.
APP_ORIGIN=

# Exact emails allowed into the Warden admin surface. Empty means nobody.
ADMIN_EMAILS=
